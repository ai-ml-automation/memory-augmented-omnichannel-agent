# ============================================
# Memory-Augmented Omnichannel Agent
# Environment Configuration
# ============================================

# ============================================
# Database Connections
# ============================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omnichannel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Neo4j
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=omnichannel

# ============================================
# Application Settings
# ============================================

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true

# ============================================
# Feature Flags (all disabled by default)
# ============================================

# LLM Integration (YandexGPT / vLLM / GigaChat)
ENABLE_LLM=false

# Voice Pipeline
ENABLE_VOICE=false

# ASR (Whisper / SpeechKit)
ENABLE_ASR=false

# TTS (Silero / SpeechKit)
ENABLE_TTS=false

# Memory Layer (Mem0 / Qdrant / Neo4j)
ENABLE_MEMORY=false

# ============================================
# External Services (stubs for development)
# ============================================

# Yandex Cloud
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# LLM
LLM_API_BASE_URL=
LLM_API_KEY=

# Voice
WHISPER_MODEL=large-v3
SILERO_MODEL_PATH=

# CTI (Naumen / Asterisk)
CTI_API_URL=
CTI_API_KEY=

# Messenger Tokens
MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# Vault
VAULT_TOKEN=dev-token
VAULT_URL=http://localhost:8200
